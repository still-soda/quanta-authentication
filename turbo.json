{
   "$schema": "https://turborepo.com/schema.json",
   "ui": "tui",
   "tasks": {
      "build": {
         "dependsOn": [
            "^build"
         ],
         "inputs": [
            "$TURBO_DEFAULT$",
            ".env*"
         ],
         "outputs": [
            "dist/**"
         ]
      },
      "dev": {
         "cache": false,
         "persistent": true
      },
      "lint": {
         "dependsOn": [
            "^lint"
         ],
         "inputs": [
            "$TURBO_DEFAULT$"
         ]
      },
      "check-types": {
         "dependsOn": [
            "^check-types"
         ],
         "inputs": [
            "$TURBO_DEFAULT$"
         ]
      },
      "preview": {
         "dependsOn": [
            "build"
         ],
         "cache": false,
         "persistent": true
      }
   }
}